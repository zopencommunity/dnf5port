-    OptionPath config_file_path{CONF_FILENAME};
+    OptionPath config_file_path{[]() {
+        // Check for DNF5_PREFIX environment variable (e.g., "/opt/pkg" or "/")
+        const char* env_prefix = std::getenv("DNF5_PREFIX");
+        if (env_prefix) {
+            std::string prefix(env_prefix);
+            // Remove trailing slash if present (unless it's just "/")
+            if (prefix.length() > 1 && prefix.back() == '/') {
+                prefix.pop_back();
+            }
+            return prefix + "/etc/dnf/dnf.conf";
+        }
+        return std::string(CONF_FILENAME);
+    }()};
     OptionBool plugins{true};
     OptionPath pluginpath{DEFAULT_LIBDNF5_PLUGINS_LIB_DIR};
     OptionPath pluginconfpath{PLUGINS_CONF_DIR};
